{
  "rewrites": [
    {
      "source": "/api/messages",
      "destination": "/api/profile?messages=1"
    },
    {
      "source": "/api/settings",
      "destination": "/api/profile?qg=settings"
    },
    {
      "source": "/api/auth/discord",
      "destination": "/api/profile?qg=discord"
    },
    {
      "source": "/api/auth/discord/callback",
      "destination": "/api/profile?qg=discord&callback=1"
    },
    {
      "source": "/api/access",
      "destination": "/api/site-config?access=1"
    },
    {
      "source": "/travaux",
      "destination": "/travaux.html"
    }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/travaux.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/gate.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/travaux.js",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/travaux.css",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache, must-revalidate"
        }
      ]
    },
    {
      "source": "/api/access",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        }
      ]
    },
    {
      "source": "/api/site-config",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, private"
        }
      ]
    }
  ]
}
